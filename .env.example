# Clinical Trial Predictor - Environment Configuration Template
# 
# SECURITY WARNING:
# This is an EXAMPLE file - DO NOT commit your actual .env file to Git
# Copy this to .env and fill in your actual values
# The .gitignore will protect your .env from being uploaded


HF_TOKEN=""

# Google Cloud Speech & TTS (credentials file path)
GOOGLE_APPLICATION_CREDENTIALS=secrets/speech_key.json

AWS_USER_NAME ="API-User"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Claude 3.5 Sonnet (Use cross-region inference profile)
AWS_SONNET_45="us.anthropic.claude-sonnet-4-5-20250929-v1:0"

# ============================================================================
# AWS BEDROCK CONFIGURATION (Required for Text Generation - Claude Sonnet 4.5)
# ============================================================================
# AWS Bedrock is now the primary API for all text generation.
# Get credentials from AWS IAM Console.
# Note: Google Cloud is still used for Speech-to-Text and Text-to-Speech services.

# ============================================================================
# GOOGLE CLOUD CONFIGURATION (Optional - for Speech Services)
# ============================================================================
# For Cloud Run or Vertex AI integration
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# VERTEX_AI_LOCATION=us-central1

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# APP_ENV=development          # development or production
# APP_DEBUG=true              # Enable debug mode
# APP_PORT=8000               # Server port
# APP_HOST=0.0.0.0            # Server host


# ============================================================================
# DATABASE SETTINGS
# ============================================================================
# DATA_DIR=./data
# TRIALS_CSV=./data/trials.csv
# DRUGS_CSV=./data/drugs.csv
# PATIENTS_CSV=./data/patients.csv
# OUTCOMES_CSV=./data/outcomes.csv

# ============================================================================
# OPTIONAL API KEYS
# ============================================================================
# OPENAI_API_KEY=sk-...              # If using OpenAI models
# LANGCHAIN_API_KEY=lsk_...          # If using LangChain

# ============================================================================
# NOTES
# ============================================================================
# - This file should NOT be committed to Git
# - Each developer should create their own .env with their API keys
# - For production, use secure secret management (Cloud Secret Manager, etc.)
# - Never share your API keys in code or documentation
# - .gitignore protects this file automatically
